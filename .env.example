DATABASE_URL=""

# S3-compatible object storage (bare git repos are stored here)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Optional; defaults shown are used when unset
S3_ENDPOINT="https://storage.railway.app"
S3_REGION="auto"

REDIS_URL=""

BETTER_AUTH_SECRET=""

# Public URLs. In production these must be set explicitly.
# WEB_URL is the web app origin; the API URL is read from RAILWAY_PUBLIC_DOMAIN
# in production and falls back to localhost in development.
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# Web app (Next.js) — NEXT_PUBLIC_ vars are inlined into the client bundle at
# BUILD time. For local dev this lives in apps/web/.env.local; in Docker it is
# passed as a build arg.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Mobile app (Expo) — must be prefixed with EXPO_PUBLIC_
EXPO_PUBLIC_API_URL="http://localhost:3001"

# Comma-separated extra origins allowed to use the OAuth provider (optional)
OAUTH_CLIENT_ORIGINS=""

RESEND_API_KEY=""
EMAIL_FROM="GitBruv <noreply@gitbruv.dev>"

# API server port (optional; defaults to 3001)
PORT="3001"
